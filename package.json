{
  "name": "agentbelt-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b packages/core plugins/git plugins/testing plugins/workflows plugins/tokens plugins/agent packages/cli",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=source --import tsx --test \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
