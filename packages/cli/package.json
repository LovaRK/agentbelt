{
  "name": "agentbelt",
  "version": "0.2.0",
  "description": "One install, every AI agent: safe git, testing and workflow tools for DeepSeek Harness, Claude Code, Codex and any MCP client",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LovaRK/agentbelt.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/LovaRK/agentbelt#readme",
  "bugs": "https://github.com/LovaRK/agentbelt/issues",
  "type": "module",
  "bin": {
    "agentbelt": "dist/cli.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "deepseek",
    "claude-code",
    "codex",
    "git",
    "testing",
    "workflows"
  ],
  "dependencies": {
    "@agentbelt/core": "0.2.0",
    "@agentbelt/plugin-git": "0.2.0",
    "@agentbelt/plugin-testing": "0.2.0",
    "@agentbelt/plugin-workflows": "0.2.0",
    "@agentbelt/plugin-agent": "0.2.0",
    "@agentbelt/plugin-tokens": "0.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
